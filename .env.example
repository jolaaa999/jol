# ── Newsletter（二选一）────────────────────────────────
# 推荐 Resend：https://resend.com → API Keys
NEWSLETTER_PROVIDER=resend
# Resend API Key — 必须选 Full access（不能只选 Sending）
# 生成后只粘贴 re_ 开头的一串，不要加引号、不要有空格换行
RESEND_API_KEY=re_xxxxxxxx
# 发件人（需在 Resend 验证域名；测试可用 onboarding@resend.dev）
RESEND_FROM_EMAIL=JOL <onboarding@resend.dev>
# 可选：把订阅者加入 Segment
# RESEND_SEGMENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 可选：有新订阅时通知站长
NEWSLETTER_NOTIFY_TO=2843422418@qq.com
SITE_URL=https://jol-ten.vercel.app

# 或用 Buttondown：https://buttondown.com → Settings → API
# NEWSLETTER_PROVIDER=buttondown
# BUTTONDOWN_API_KEY=bd-xxxxxxxx

# ── Analytics（可选）──────────────────────────────────
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=
